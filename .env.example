# ============================================================
#  Variables d'environnement — ERP EMUCI / StockApp (VPS MySQL)
#  Copier ce fichier en .env à la racine et renseigner les valeurs.
#  Le .env est chargé automatiquement par includes/db.php.
#  NE JAMAIS committer le .env avec les vraies valeurs.
# ============================================================

# --- Base de données MySQL (locale au VPS) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockapp
DB_USER=stockapp
DB_PASS=votre_mot_de_passe_mysql

# --- Application ---
APP_URL=https://votre-domaine.ci
APP_TIMEZONE=Africa/Abidjan

# --- Mails de notification (SMTP de la boîte mail ; pas l'IMAP) ---
MAIL_ENABLED=0
MAIL_HOST=mail.routing.net
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=adresse_de_la_boite
MAIL_PASS=mot_de_passe_de_la_boite
MAIL_FROM=adresse_de_la_boite
