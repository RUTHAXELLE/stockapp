# Dependencies
# NOTE (branche vps-mysql) : vendor/ est VOLONTAIREMENT versionné ici pour un
# déploiement VPS sans `composer install`. Sur main (Render), il reste ignoré.
# /vendor/

# Secrets locaux (identifiants DB / APP_URL) — jamais committer
/.env

# Uploaded files (user content, not code)
/uploads/fiches/*
/uploads/bl/*
/uploads/feb/*
/uploads/validation/*
/uploads/fournisseurs/*
!/uploads/fiches/.gitkeep
!/uploads/bl/.gitkeep
!/uploads/feb/.gitkeep
!/uploads/validation/.gitkeep
!/uploads/fournisseurs/.gitkeep

# includes/db.php ne contient PLUS de secrets (config via variables
# d'environnement) : il DOIT être versionné pour le déploiement Render.

# Database dumps (may contain sensitive data)
/database.sql

# Verrous LibreOffice / sauvegardes
.~lock.*#
*.bak

# Test & install scripts
/test_db.php
/test_csp.php
/install.php

# OS & editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Config locale Claude Code (ne pas versionner)
.claude/settings.local.json

# Chaîne de connexion de la base de recette (Neon) — jamais versionnée.
# Créer le fichier à la main, une seule ligne :
#     RECETTE_DSN=postgresql://user:motdepasse@hote/base?sslmode=require
.env.recette

# Fichiers de travail temporaires
.mien_*.tmp
.di_css.tmp

# Fiches de mise à jour générées par tools/fiche_mise_a_jour.sh
fiches_mise_a_jour/
